---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { getSupabase } from '@/lib/supabase';
import type { Product } from '@/types/product';
import { SITE } from '@/lib/site';
import { formatPrice } from '@/lib/products';
import { CATEGORIES } from '@/lib/categories';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const content = CATEGORIES[slug];
if (!content) {
  return Astro.redirect('/');
}

const supabase = getSupabase();
const { data: products } = await supabase
  .from('products')
  .select('*')
  .eq('is_active', true)
  .order('display_order', { ascending: true })
  .order('name', { ascending: true });

const matched: Product[] = ((products ?? []) as Product[]).filter((p) => {
  if (slug === 'quesos-frescos') {
    return p.category.toLowerCase().includes('queso');
  }
  if (slug === 'yogurt-y-kefir') {
    const blob = `${p.name} ${p.short_description}`.toLowerCase();
    return (
      p.category.toLowerCase().includes('lácteo') ||
      blob.includes('yogurt') ||
      blob.includes('yogur') ||
      blob.includes('kéfir') ||
      blob.includes('kefir')
    );
  }
  return false;
});

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: content.title, item: `${SITE.url}/${content.slug}/` },
  ],
};
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  canonical={`/${content.slug}/`}
>
  <section class="bg-gradient-to-b from-cream-50 to-white py-16 md:py-24">
    <Container>
      <nav aria-label="Migas" class="mb-6 text-xs text-espresso-500">
        <a href="/" class="hover:text-cheddar">Inicio</a>
        <span aria-hidden="true"> / </span>
        <span class="text-espresso-700">{content.title}</span>
      </nav>
      <SectionTitle
        eyebrow={SITE.tagline}
        title={content.h1}
        subtitle={content.intro}
      />

      <ul class="mt-8 grid gap-2 sm:grid-cols-2">
        {
          content.benefits.map((b) => (
            <li class="flex items-start gap-2 rounded-2xl border border-espresso-900/10 bg-white px-4 py-3 text-sm text-espresso-700 shadow-card">
              <span class="mt-0.5 text-cheddar">✓</span>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="bg-white py-16">
    <Container>
      <div class="mx-auto max-w-3xl space-y-4 text-base leading-relaxed text-espresso-700">
        {content.longCopy.map((p) => <p>{p}</p>)}
      </div>
    </Container>
  </section>

  {
    matched.length > 0 && (
      <section class="bg-cream-50/40 py-16">
        <Container>
          <h2 class="font-display text-2xl font-extrabold text-espresso-900 sm:text-3xl">
            Catálogo disponible
          </h2>
          <p class="mt-2 max-w-2xl text-sm text-espresso-700">
            Estos son los productos que más piden nuestros clientes en la sabana de Bogotá.
            Disponibilidad diaria: escríbenos por WhatsApp para confirmar precio y entrega.
          </p>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {matched.map((p) => (
              <li class="overflow-hidden rounded-2xl border border-espresso-900/10 bg-white shadow-card">
                <div class="aspect-4/3 bg-cream-100">
                  <img
                    src={p.image_url}
                    alt={p.name}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="p-4">
                  <h3 class="font-display text-base font-extrabold text-espresso-900">
                    {p.name}
                  </h3>
                  <p class="mt-1 line-clamp-2 text-xs text-espresso-700">
                    {p.short_description}
                  </p>
                  <div class="mt-3 flex items-center justify-between text-xs">
                    <span class="font-bold text-cheddar">
                      {p.price != null ? formatPrice(p.price) : 'A convenir'}
                    </span>
                    <span class="text-espresso-700/70">
                      {p.stock != null ? `${p.stock} disp.` : 'Consultar'}
                    </span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  <section class="bg-cream-50 py-16">
    <Container>
      <div class="mx-auto max-w-3xl rounded-3xl border border-cheddar/20 bg-cheese-100/70 p-8 text-center">
        <h2 class="font-display text-2xl font-extrabold text-espresso-900">
          ¿Buscas {content.related.join(', ')}?
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-espresso-700">
          Escríbenos por WhatsApp y te enviamos disponibilidad del día, precio por kilo o por
          unidad, y opciones de entrega a domicilio en Mosquera, Madrid, Funza u occidente de
          Bogotá.
        </p>
        <a
          href={`https://wa.me/${SITE.phoneRaw.replace('+', '')}?text=${encodeURIComponent(`Hola ${SITE.name}, me interesa ${content.title.toLowerCase()}.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-6 inline-flex"
        >
          Pedir por WhatsApp
        </a>
      </div>
    </Container>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(pageLd)} is:inline />
</BaseLayout>
